+/**
+ * [SSO-2] The per-user session keys api/system-redirect.php set when a
+ * system was launched from the old dashboard (its requires_setup
+ * handlers). An IMIS sign-in arrives at the subsystem directly, so they
+ * are set here, for every system at once — each is a fact about the user,
+ * harmless where unused. A missing table (not every server has every
+ * subsystem) is skipped.
+ * @internal
+ */
+function _session_sso_system_setup(int $userId): void
+{
+    global $conn;
+
+    $lookups = [
+        // CTS — Legal Services Division case handlers.
+        'SELECT id, ao_number FROM cts_manage_users WHERE user = :id LIMIT 1' => static function (array $row): void {
+            $_SESSION['cts_user_id'] = (int) $row['id'];
+            $_SESSION['ao_number']   = (string) ($row['ao_number'] ?? '');
+        },
+        // RFCS — active drivers.
+        "SELECT id FROM trip_drivers WHERE user = :id AND status != 'Inactive' LIMIT 1" => static function (array $row): void {
+            $_SESSION['driver_id'] = (int) $row['id'];
+        },
+    ];
+
+    foreach ($lookups as $sql => $apply) {
+        try {
+            $stmt = $conn->prepare($sql);
+            $stmt->execute([':id' => $userId]);
+            if ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
+                $apply($row);
+            }
+        } catch (PDOException $e) {
+            error_log('[session.php] SSO setup lookup skipped: ' . $e->getMessage());
+        }
+    }
+
+    // ICTSRTS — ITG membership.
+    try {
+        $stmt = $conn->prepare('SELECT id FROM itg_tbl WHERE id = :id LIMIT 1');
+        $stmt->execute([':id' => $userId]);
+        $_SESSION['is_itg_member'] = (bool) $stmt->fetch();
+    } catch (PDOException $e) {
+        error_log('[session.php] SSO setup lookup skipped: ' . $e->getMessage());
+    }
+}
