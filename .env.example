APP_NAME="CSC RO VIII IMIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Extra host names the app answers to (comma-separated); APP_URL's host is always trusted.
# Outside local, any other Host header is refused. TRUSTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=csc_ro8_imis
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=480
SESSION_IDLE_WARNING=5
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

IMIS_VERSION=3.5.0

# Legacy IMIS bridge (config/legacy.php, deploy/legacy-imis/README.md).
# Single sign-on into the old PHP subsystems: launch URLs on these hosts
# (comma-separated) get a one-time ?sso_token=. Empty = off.
LEGACY_SSO_HOSTS=
# Laravel systems under IMIS, as host[:port] (e.g. PROCTAD)
SSO_HUB_HOSTS=
LEGACY_SSO_REQUIRE_PATH=false
# Bearer token the Recruitment Portal uses to read vacant plantilla items and report selections. Empty = off.
RECRUITMENT_API_TOKEN=
# Bearer token JPortal uses to read the public office directory feed. Empty = off.
JPORTAL_API_TOKEN=
# Mirror accounts and system access into the legacy database.
LEGACY_BRIDGE=false
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=u390694310_cscro8
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Bearer token ICT SRTS sends to read the employee list (/api/v1/ictsrts/employees). Empty = off.
ICTSRTS_API_TOKEN=
# Short name of the committee that is the Information Technology Group; its active members are ITG members in ICT SRTS.
ICTSRTS_ITG_COMMITTEE=ITG

# Bearer token ETTS sends to read the people directory (/api/v1/etts/employees). Empty = off.
ETTS_API_TOKEN=

# Bearer token IPCRS sends to read the employee list (/api/v1/ipcrs/employees). Empty = off.
IPCRS_API_TOKEN=
# Short name of the committee that is the Performance Management Team; its active members can see every IPCRS form and rating.
IPCRS_PMT_COMMITTEE=PMT

# Bearer token PROCTAD sends to read the staff who hold a PROCTAD role (/api/v1/proctad/users). Empty = off.
PROCTAD_API_TOKEN=
# Short name of PROCTAD's entry in the application directory.
PROCTAD_APPLICATION=PROCTAD
